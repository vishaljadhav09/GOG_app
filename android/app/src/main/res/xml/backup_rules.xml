<?xml version="1.0" encoding="utf-8"?>
<!-- Same policy as data_extraction_rules.xml, for Android 6-11 (API 23-30) full backup:
     keep only the WebView localStorage that holds the game's numeric progress save. -->
<full-backup-content>
    <include domain="root" path="app_webview/Default/Local Storage" />
</full-backup-content>
