<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Minimal permissions: the game is an offline HTML5 canvas game.
         INTERNET is kept because the Capacitor WebView bridge has not been verified on a device without it
         (see PLAY-STORE-CHECKLIST.md, "INTERNET permission follow-up"). No network is used at runtime;
         plain-text HTTP is blocked by network_security_config.xml. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Touch is the only input the game is designed for (3-10 year olds tapping/dragging). -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <!-- The game is locked to landscape, but sensorLandscape works on every phone/tablet, so neither
         orientation is a hard requirement: 'required=false' stops Google Play from filtering out devices
         (e.g. a portrait-only-reported or landscape-only-reported device) because of the orientation lock. -->
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:exported="true"
            android:label="@string/title_activity_main"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/AppTheme.NoActionBarLaunch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
