{
  "name": "guardians-of-gaia-app",
  "version": "1.0.0",
  "description": "Android (Capacitor) build wrapper for Guardians of Gaia. The game itself lives in the web/ submodule.",
  "scripts": {
    "build": "node scripts/build-www.js",
    "update-web": "git submodule update --init --remote web",
    "sync": "npm run build && npx cap sync android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishaljadhav09/GOG_app.git"
  },
  "bugs": {
    "url": "https://github.com/vishaljadhav09/GOG_app/issues"
  },
  "homepage": "https://github.com/vishaljadhav09/GOG_app#readme",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  },
  "private": true
}
